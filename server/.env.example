# Copy to .env and fill in. .env is gitignored; this file must hold no real values.

# ---------- database ----------
# Local PostgreSQL. Note the port: 5432 is the default.
DATABASE_URL=postgresql://localhost:5432/aura_reflect
TEST_DATABASE_URL=postgresql://localhost:5432/aura_reflect_test

# ---------- server ----------
PORT=4300
NODE_ENV=development

# Must match the frontend origin EXACTLY, or CORS drops the session cookie.
FRONTEND_URL=http://localhost:5173

# ---------- session ----------
# Signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string

# How long a session stays valid, in milliseconds. Default 7 days.
SESSION_MAX_AGE_MS=604800000
