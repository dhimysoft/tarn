# AURA Intelligence — Environment Variables
# Copy this file to .env and fill in your values.
# .env is excluded from git and must never be committed.

# Optional: Gemini 2.0 Flash API key for AI advisory insights.
# If not set, the /api/wellness/insight endpoint returns a graceful fallback.
# All scoring, burnout detection, and recommendations work without this key.
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Server port (default: 5001)
PORT=5001
