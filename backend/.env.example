# TARN — Environment Variables
# Copy this file to backend/.env and fill in your values.
# .env is excluded from git and must never be committed.

# Optional: a FREE Gemini API key for the AI-written reflection on the dashboard.
# Without it everything still works: the dashboard shows its built-in reflection.
#
# STAY FREE: create the key at https://aistudio.google.com/apikey, keep the
# project it belongs to on the "Free of charge" plan, and NEVER add a billing
# account to that project. A key with no billing account cannot be charged:
# past the free limit Google just refuses the request. See README, "Gemini:
# staying free".
GEMINI_API_KEY=

# Optional. Must be a model Google lists as free (see FREE_MODELS in
# backend/gemini.js). Anything else is ignored, so this cannot cause a charge.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. The most Gemini calls this server will make in one day, across all
# visitors. Defaults to 150, well under the free allowance.
# GEMINI_DAILY_CAP=150

# Server port (default: 5001)
PORT=5001
